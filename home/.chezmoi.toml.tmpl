{{- $codespaces := env "CODESPACES" | not | not -}}
sourceDir = {{ .chezmoi.sourceDir | quote }}

{{- /* Inside a container the state DB sits at the root of $HOME rather than
       under ~/.config. Containers commonly mount volumes over the XDG dirs
       (~/.config, ~/.cache, ~/.local/share, ~/.local/state) while the rest of
       $HOME — notably ~/.local/bin, where the installer scripts put their
       binaries — belongs to the container's own filesystem. Keeping the state
       DB out of those volumes ties chezmoi's bookkeeping to the lifetime of
       the tree it describes: a recreated container starts stateless and
       re-runs the run_once/run_onchange installers that repopulate
       ~/.local/bin, while a restarted one keeps both. Every one of those
       scripts is guarded (command -v / append-if-missing), so a re-run on an
       already-provisioned container is a no-op. */ -}}
{{- if stat "/.dockerenv" }}
persistentState = {{ joinPath .chezmoi.homeDir ".chezmoistate.boltdb" | quote }}
{{- end }}

[data]
    codespaces = {{ $codespaces }}

[git]
    autoCommit = true
    autoPush = true

{{- /* Per-OS zv installer hook. The script bodies live next to this repo
       (one above sourceDir, since .chezmoiroot points at home/). The Linux
       script downloads the linux build of zv; the Windows script downloads
       the win build. macOS isn't wired up yet — install zv manually if you
       need secret templating there. */ -}}
{{- if eq .chezmoi.os "linux" }}
[hooks.read-source-state.pre]
    command = {{ joinPath (.chezmoi.sourceDir | dir) ".install-zv.sh" | quote }}
{{- else if eq .chezmoi.os "windows" }}
[hooks.read-source-state.pre]
    command = "powershell"
    args = ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", {{ joinPath (.chezmoi.sourceDir | dir) ".install-zv.ps1" | quote }}]
{{- end }}

# Wire Zoho Vault CLI as chezmoi's secret backend.
# This enables the secretJSON template function in any *.tmpl file.
# The configured args are always prepended, so in templates you only pass the ID.
#
# Requires zv to be authenticated before running chezmoi apply.
# For bulk env-var secrets, prefer purse-install-secrets instead (no auth needed at apply time).
{{/*
Minimal usage in any *.tmpl:

    {{ secretJSON "-id" "YOUR_VAULT_ITEM_ID" }}

Full usage example (e.g. in ~/.config/some-tool/config.toml.tmpl):

    {{- $item := secretJSON "-id" "2000002716908" -}}
    {{- $pass := "" -}}
    {{- range $item.secret.secretData -}}
    {{-   if eq .id "password" }}{{- $pass = .value -}}{{- end -}}
    {{- end -}}
    api_key = "{{ $pass }}"
*/}}
[secret]
    command = "zv"
    args = ["get", "--not-safe", "--output", "json"]
