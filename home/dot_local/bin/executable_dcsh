#!/usr/bin/env bash
# dcsh — open a shell (or run a command) inside the devcontainer for the
# current project.
#
# Usage:
#   dcsh [options] [-- <cmd> [args...]]
#
# Options:
#   -w, --workspace <path>   Workspace folder (default: nearest ancestor with
#                            .devcontainer/ or .devcontainer.json, else cwd).
#   -c, --config <path>      Path to devcontainer.json (required when the
#                            container was started with a non-default config,
#                            e.g. .devcontainer/sidecar/devcontainer.json).
#   -s, --shell <shell>      Shell to launch (default: bash).
#   -a, --agent <name>       Launch an AI agent CLI instead of a shell,
#                            installing it in the container if it isn't there.
#   -u, --user <user>        Remote user to exec as (passed via --remote-env).
#   -h, --help               Show this help.
#
# Anything after -- is passed as the command to exec instead of a shell.
#
# Examples:
#   dcsh                     # bash in the container for this project
#   dcsh -s zsh              # zsh instead
#   dcsh -a claude           # straight into Claude Code (alias: dcclaude)
#   dcsh -- rails console    # run a specific command
#   dcsh -w ../other         # target a neighbouring workspace
#
# If no container is running for this worktree, falls back to a container
# started from any sibling worktree of the same repository (one devcontainer,
# many worktrees inside), then runs `wt switch <branch>` to land back here.
#
# Run from a herdr pane, this also makes the containerised process legible to
# herdr: it hands the pane's identity to the container, and, when the agent is
# named up front, tells herdr's detector what to call the process. See the
# "herdr" section below. DCSH_HERDR=0 opts out.

set -euo pipefail

die() { printf 'dcsh: %s\n' "$*" >&2; exit 1; }

command -v devcontainer >/dev/null 2>&1 || die "'devcontainer' not found on PATH (install @devcontainers/cli)"

# ── defaults ────────────────────────────────────────────────────────────────
workspace=""
config_file=""
shell_cmd="bash"
remote_user=""
agent=""
extra_cmd=()

# ── argument parsing ─────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    -w|--workspace)
      workspace="${2:?--workspace requires a path}"; shift 2 ;;
    -c|--config)
      config_file="${2:?--config requires a path}"; shift 2 ;;
    -s|--shell)
      shell_cmd="${2:?--shell requires a shell name}"; shift 2 ;;
    -a|--agent)
      agent="${2:?--agent requires an agent name}"; shift 2 ;;
    -u|--user)
      remote_user="${2:?--user requires a username}"; shift 2 ;;
    --)
      shift; extra_cmd=("$@"); break ;;
    -*)
      die "unknown option: $1" ;;
    *)
      die "unexpected argument: $1 (use -- to pass a command)" ;;
  esac
done

# ── locate the workspace and its running devcontainer ────────────────────────
lookup_lib="$HOME/.local/share/purse/lib/devcontainer-lookup.sh"
[[ -r "$lookup_lib" ]] || die "missing $lookup_lib"
# shellcheck source=../share/purse/lib/devcontainer-lookup.sh
. "$lookup_lib"

agents_lib="$HOME/.local/share/purse/lib/herdr-agents.sh"
[[ -r "$agents_lib" ]] || die "missing $agents_lib"
# shellcheck source=../share/purse/lib/herdr-agents.sh
. "$agents_lib"

# --agent takes either the command or herdr's short name for it — `cursor-agent`
# or `cursor`. Resolve to the command, since that is what the container runs.
if [[ -n "$agent" ]]; then
  agent_command=""
  for candidate in $(purse_agent_commands); do
    if [[ "$candidate" == "$agent" || "$(purse_agent_short_name "$candidate")" == "$agent" ]]; then
      agent_command="$candidate"
      break
    fi
  done
  [[ -n "$agent_command" ]] || die "unknown agent: $agent (try one of: $(purse_agent_installable_commands | tr '\n' ' '))"
  # Through a login shell, so ~/.local/bin is on PATH: `devcontainer exec` runs
  # the command directly, with none of the environment an interactive shell has.
  extra_cmd=(bash --login -c 'exec purse-agent "$@"' _ "$agent_command" ${extra_cmd[@]+"${extra_cmd[@]}"})
fi

if [[ -z "$workspace" ]]; then
  workspace="$(devcontainer_find_workspace)"
fi

resolved="$(devcontainer_resolve "$workspace")" ||
  die "no running devcontainer found for workspace: $workspace"
container_id="${resolved%%$'\t'*}"
container_workspace="${resolved#*$'\t'}"

# The container may belong to a sibling worktree — one devcontainer serves every
# worktree of a repository. `wt switch` lands us back on this worktree's branch
# once we have a shell.
switch_branch=""
if [[ "$container_workspace" != "$workspace" ]]; then
  switch_branch="$(git -C "$workspace" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  printf 'dcsh: no container for %s — using sibling worktree %s, then `wt switch %s`\n' \
    "$workspace" "$container_workspace" "$switch_branch" >&2
  workspace="$container_workspace"
fi

# An explicit --config wins; otherwise derive it from the running container so
# sidecar/non-default configs are picked up automatically.
[[ -z "$config_file" ]] && config_file="$(devcontainer_config_label "$container_id")"

# ── build exec arguments ─────────────────────────────────────────────────────
exec_args=(
  --workspace-folder "$workspace"
  --terminal-columns "$(tput cols 2>/dev/null || echo 220)"
  --terminal-rows    "$(tput lines 2>/dev/null || echo 50)"
)

if [[ -n "$container_id" ]]; then
  exec_args+=(--container-id "$container_id")
  printf 'dcsh: container → %s\n' "$container_id" >&2
fi

if [[ -n "$config_file" ]]; then
  exec_args+=(--config "$config_file")
  printf 'dcsh: config    → %s\n' "$config_file" >&2
fi

[[ -n "$remote_user" ]] && exec_args+=(--remote-env "LOGNAME=$remote_user")

# ── herdr ────────────────────────────────────────────────────────────────────
# herdr names the agent in a pane from that pane's foreground process, and
# reads its state off the terminal. The terminal crosses the container wall by
# itself; the other two do not, so hand them over.
#
# The pane's identity is what the agent's integration hook needs to report its
# session id back, and $HERDR_SOCKET_PATH is where it looks for somewhere to
# report it — pointed here at the relay dcbridge maintains. A container without
# that relay just leaves the hook with a socket that will not connect, which it
# already treats as "no herdr" and skips.
herdr_relay_socket=/dev/shm/herdr.sock

if [[ "${DCSH_HERDR:-1}" != "0" && "${HERDR_ENV:-}" = "1" && -n "${HERDR_PANE_ID:-}" ]]; then
  exec_args+=(
    --remote-env "HERDR_ENV=1"
    --remote-env "HERDR_PANE_ID=$HERDR_PANE_ID"
    --remote-env "HERDR_SOCKET_PATH=$herdr_relay_socket"
  )
fi

# Naming the agent. herdr reads HERDR_AGENT from the environment of the pane's
# foreground process — out here, the `devcontainer` CLI — and treats that
# process as the named agent, applying the same screen-detection manifest it
# would use for a host-run one. The agent's UI arrives through this pty either
# way, so state comes out exactly as good as it does on the host.
#
# It has to be set before the exec below, which is why only `--agent` (or an
# agent named after --) can use it. Typing the agent's name at a container
# prompt instead is covered on the other side: `purse-agent` reports the pane
# over the relay socket. Override with DCSH_AGENT, opt out with DCSH_HERDR=0.
herdr_agent="${DCSH_AGENT:-}"
if [[ -z "$herdr_agent" && "${DCSH_HERDR:-1}" != "0" ]]; then
  if [[ -n "$agent" ]]; then
    herdr_agent="$(purse_agent_kind "$agent_command")"
  elif [[ ${#extra_cmd[@]} -gt 0 ]]; then
    herdr_agent="$(purse_agent_kind "$(basename "${extra_cmd[0]}")")"
  fi
fi

[[ -n "$herdr_agent" ]] && export HERDR_AGENT="$herdr_agent"

# ── build the command to run inside the container ────────────────────────────
if [[ -n "$switch_branch" ]]; then
  # Attempt the worktree switch first; if it fails (e.g. branch has no
  # worktree inside the container yet), fall through to a shell/command in
  # whichever worktree the container landed in rather than dying.
  if [[ ${#extra_cmd[@]} -gt 0 ]]; then
    cmd=(bash --login -c 'wt switch "$1" || true; shift; exec "$@"' _ "$switch_branch" "${extra_cmd[@]}")
  else
    cmd=(bash --login -c 'wt switch "$1" || true; exec "$2" --login' _ "$switch_branch" "$shell_cmd")
  fi
elif [[ ${#extra_cmd[@]} -gt 0 ]]; then
  cmd=("${extra_cmd[@]}")
else
  cmd=("$shell_cmd" --login)
fi

printf 'dcsh: workspace → %s\n' "$workspace" >&2
exec devcontainer exec "${exec_args[@]}" "${cmd[@]}"
