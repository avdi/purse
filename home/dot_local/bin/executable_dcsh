#!/usr/bin/env bash
# dcsh — open a shell (or run a command) inside the devcontainer for the
# current project.
#
# Usage:
#   dcsh [options] [-- <cmd> [args...]]
#
# Options:
#   -w, --workspace <path>   Workspace folder (default: nearest ancestor with
#                            .devcontainer/ or .devcontainer.json, else cwd).
#   -c, --config <path>      Path to devcontainer.json (required when the
#                            container was started with a non-default config,
#                            e.g. .devcontainer/sidecar/devcontainer.json).
#   -s, --shell <shell>      Shell to launch (default: bash).
#   -u, --user <user>        Remote user to exec as (passed via --remote-env).
#   -h, --help               Show this help.
#
# Anything after -- is passed as the command to exec instead of a shell.
#
# Examples:
#   dcsh                     # bash in the container for this project
#   dcsh -s zsh              # zsh instead
#   dcsh -- rails console    # run a specific command
#   dcsh -w ../other         # target a neighbouring workspace
#
# If no container is running for this worktree, falls back to a container
# started from any sibling worktree of the same repository (one devcontainer,
# many worktrees inside), then runs `wt switch <branch>` to land back here.

set -euo pipefail

die() { printf 'dcsh: %s\n' "$*" >&2; exit 1; }

command -v devcontainer >/dev/null 2>&1 || die "'devcontainer' not found on PATH (install @devcontainers/cli)"

# ── defaults ────────────────────────────────────────────────────────────────
workspace=""
config_file=""
shell_cmd="bash"
remote_user=""
extra_cmd=()

# ── argument parsing ─────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    -w|--workspace)
      workspace="${2:?--workspace requires a path}"; shift 2 ;;
    -c|--config)
      config_file="${2:?--config requires a path}"; shift 2 ;;
    -s|--shell)
      shell_cmd="${2:?--shell requires a shell name}"; shift 2 ;;
    -u|--user)
      remote_user="${2:?--user requires a username}"; shift 2 ;;
    --)
      shift; extra_cmd=("$@"); break ;;
    -*)
      die "unknown option: $1" ;;
    *)
      die "unexpected argument: $1 (use -- to pass a command)" ;;
  esac
done

# ── locate the workspace and its running devcontainer ────────────────────────
lookup_lib="$HOME/.local/share/purse/lib/devcontainer-lookup.sh"
[[ -r "$lookup_lib" ]] || die "missing $lookup_lib"
# shellcheck source=../share/purse/lib/devcontainer-lookup.sh
. "$lookup_lib"

if [[ -z "$workspace" ]]; then
  workspace="$(devcontainer_find_workspace)"
fi

resolved="$(devcontainer_resolve "$workspace")" ||
  die "no running devcontainer found for workspace: $workspace"
container_id="${resolved%%$'\t'*}"
container_workspace="${resolved#*$'\t'}"

# The container may belong to a sibling worktree — one devcontainer serves every
# worktree of a repository. `wt switch` lands us back on this worktree's branch
# once we have a shell.
switch_branch=""
if [[ "$container_workspace" != "$workspace" ]]; then
  switch_branch="$(git -C "$workspace" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  printf 'dcsh: no container for %s — using sibling worktree %s, then `wt switch %s`\n' \
    "$workspace" "$container_workspace" "$switch_branch" >&2
  workspace="$container_workspace"
fi

# An explicit --config wins; otherwise derive it from the running container so
# sidecar/non-default configs are picked up automatically.
[[ -z "$config_file" ]] && config_file="$(devcontainer_config_label "$container_id")"

# ── build exec arguments ─────────────────────────────────────────────────────
exec_args=(
  --workspace-folder "$workspace"
  --terminal-columns "$(tput cols 2>/dev/null || echo 220)"
  --terminal-rows    "$(tput lines 2>/dev/null || echo 50)"
)

if [[ -n "$container_id" ]]; then
  exec_args+=(--container-id "$container_id")
  printf 'dcsh: container → %s\n' "$container_id" >&2
fi

if [[ -n "$config_file" ]]; then
  exec_args+=(--config "$config_file")
  printf 'dcsh: config    → %s\n' "$config_file" >&2
fi

[[ -n "$remote_user" ]] && exec_args+=(--remote-env "LOGNAME=$remote_user")

# ── build the command to run inside the container ────────────────────────────
if [[ -n "$switch_branch" ]]; then
  # Attempt the worktree switch first; if it fails (e.g. branch has no
  # worktree inside the container yet), fall through to a shell/command in
  # whichever worktree the container landed in rather than dying.
  if [[ ${#extra_cmd[@]} -gt 0 ]]; then
    cmd=(bash --login -c 'wt switch "$1" || true; shift; exec "$@"' _ "$switch_branch" "${extra_cmd[@]}")
  else
    cmd=(bash --login -c 'wt switch "$1" || true; exec "$2" --login' _ "$switch_branch" "$shell_cmd")
  fi
elif [[ ${#extra_cmd[@]} -gt 0 ]]; then
  cmd=("${extra_cmd[@]}")
else
  cmd=("$shell_cmd" --login)
fi

printf 'dcsh: workspace → %s\n' "$workspace" >&2
exec devcontainer exec "${exec_args[@]}" "${cmd[@]}"
