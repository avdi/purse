#!/usr/bin/env bash
# purse-install-secrets — pull dotfiles secrets from Zoho Vault into ~/.config/shell/secrets.sh
#
# Usage: purse-install-secrets
#
# Secrets are stored as custom key/value fields on a single Secure Note in
# Zoho Vault named "PURSE_TOKENS". Add a field there for each env var you want
# exported globally. No local config file needed.
#
# Requires: zv (installed by chezmoi), jq

set -euo pipefail

PURSE_NOTE_NAME="PURSE_TOKENS"
SECRETS_FILE="${HOME}/.config/shell/secrets.sh"

log()  { echo "==> $*"; }
die()  { echo "❌ $*" >&2; exit 1; }
warn() { echo "⚠️  $*" >&2; }

# ── prerequisites ─────────────────────────────────────────────────────────────
command -v zv  >/dev/null 2>&1 || die "zv not found — run: chezmoi apply"
command -v jq  >/dev/null 2>&1 || die "jq not found — install it first"

# ── authentication ─────────────────────────────────────────────────────────────
log "Checking Zoho Vault authentication..."
purse-zv-ensure-auth
log "Authenticated."

# ── fetch PURSE_TOKENS note ────────────────────────────────────────────────────
# zv reports failures as prose on stdout and still exits 0, so a lapsed session
# reaches jq as a parse error and any message about the note is a guess. Vet
# every response as JSON first, and name the auth states it can be in — the
# session can expire between the check above and the calls below.
zv_json() {
  local out
  out=$(zv "$@" 2>&1 </dev/null) || die "'zv $1' failed: ${out:-no output}"
  case "$out" in
    *"not logged in"*) die "Zoho Vault: not logged in — run: zv login && zv unlock" ;;
    *"zv unlock"*)     die "Zoho Vault is locked — run: zv unlock" ;;
  esac
  printf '%s' "$out" | jq empty 2>/dev/null \
    || die "'zv $1' returned something other than JSON: $(printf '%s' "$out" | head -1)"
  printf '%s' "$out"
}

log "Looking up '${PURSE_NOTE_NAME}' in Zoho Vault..."
search_raw=$(zv_json search -k "$PURSE_NOTE_NAME" --name --strict --output json)

note_id=$(printf '%s' "$search_raw" \
  | jq -re --arg name "$PURSE_NOTE_NAME" \
      '.secrets.secret[] | select(.secretname == $name) | .secretid') \
  || die "Secure Note '${PURSE_NOTE_NAME}' not found in vault"

log "Fetching fields from note id=${note_id}..."
note_raw=$(zv_json get -id "$note_id" --not-safe --output json)

# ── write secrets file ─────────────────────────────────────────────────────────
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

{
  echo "# ~/.config/shell/secrets.sh"
  echo "# Auto-generated by purse-install-secrets from Zoho Vault '${PURSE_NOTE_NAME}'"
  echo "# Generated: $(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  echo "# DO NOT EDIT — re-run: purse-install-secrets"
  echo ""
} > "$tmp"

count=0
while IFS= read -r entry; do
  colname=$(printf '%s' "$entry" | jq -r '.colname')
  value=$(printf '%s' "$entry" | jq -r '.value')
  printf 'export %s=%q\n' "$colname" "$value" >> "$tmp"
  (( count++ )) || true
done < <(printf '%s' "$note_raw" | jq -c '.secret.customcolumn.customcol[]?')

[ "$count" -gt 0 ] \
  || die "Note '${PURSE_NOTE_NAME}' (id=${note_id}) has no custom key/value fields to export"

install -m 600 "$tmp" "$SECRETS_FILE"
log "Wrote ${count} secret(s) to ${SECRETS_FILE}"
echo ""
echo "  Open a new shell or run: source ${SECRETS_FILE}"
