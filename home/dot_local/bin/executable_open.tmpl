{{- if and (ne .chezmoi.os "windows") (ne .chezmoi.os "darwin") -}}
#!/usr/bin/env bash
# open compatibility wrapper for Linux/WSL shells.
# Some CLIs (including Zoho Vault) hardcode `open` (macOS) to launch URLs.
# This wrapper forwards to $BROWSER when configured, otherwise xdg-open.
#
# Excluded on macOS, which has the real `open` this emulates. ~/.local/bin
# precedes /usr/bin, so installing it there shadows the system command with a
# single-argument stub — breaking `open .`, `open -a App`, `open -R`, and the
# rest. The empty render tells chezmoi to remove the target.

set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: open <url-or-path>" >&2
  exit 1
fi

if [[ -n "${BROWSER:-}" ]] && [[ "${BROWSER}" != "open" ]]; then
  exec "$BROWSER" "$1"
fi

if command -v xdg-open >/dev/null 2>&1; then
  exec xdg-open "$1"
fi

echo "open: no browser launcher found. Set BROWSER or install xdg-utils." >&2
exit 127
{{- end }}