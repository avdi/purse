#!/usr/bin/env bash
# purse-zv-ensure-auth — ensure zv is logged in and vault is unlocked
#
# Detects the current auth state and runs zv login / zv unlock as needed.
# Safe to call before any zv operation; exits non-zero if vault is still
# inaccessible after attempting auth.
#
# Usage: purse-zv-ensure-auth

set -euo pipefail

die() { echo "❌ $*" >&2; exit 1; }

command -v zv >/dev/null 2>&1 || { echo "❌ zv not found" >&2; purse-zv-remedy; exit 1; }

# zv reports auth failures as prose on stdout and still exits 0, so its exit
# status says nothing about whether the vault is reachable. Every caller has to
# classify by message instead. ZV_OUTPUT carries the raw text for reporting.
# Sets ZV_STATE and ZV_OUTPUT rather than printing the state: a command
# substitution would run this in a subshell and drop the message with it.
ZV_STATE=""
ZV_OUTPUT=""
read_zv_state() {
  ZV_OUTPUT=$(zv list category 2>&1 </dev/null || true)
  case "$ZV_OUTPUT" in
    *"not logged in"*)      ZV_STATE=logged-out ;;
    *"zv unlock"*)          ZV_STATE=locked ;;
    error:*|*$'\n'error:*)  ZV_STATE=error ;;
    *)                      ZV_STATE=ready ;;
  esac
}

# zv login and zv unlock both prompt, so without a terminal the only useful
# thing to do is say which command the human needs to run.
needs_terminal() {
  [ -t 0 ] || die "$1 — no terminal to prompt on; run: $2"
}

# Only consulted once auth is actually needed: somewhere zv can't keep a
# session, walking someone through a login that silently fails to persist is
# worse than saying so.
can_hold_session() {
  command -v purse-zv-guard >/dev/null 2>&1 || return 0
  purse-zv-guard
}

read_zv_state
case "$ZV_STATE" in
  ready) exit 0 ;;
  logged-out)
    can_hold_session || exit 1
    needs_terminal "Zoho Vault: not logged in" "zv login && zv unlock"
    echo "==> Not logged in. Starting zv login..." >&2
    zv login
    echo "==> Unlocking vault..." >&2
    zv unlock
    ;;
  locked)
    can_hold_session || exit 1
    needs_terminal "Zoho Vault is locked" "zv unlock"
    echo "==> Vault is locked. Unlocking..." >&2
    zv unlock
    ;;
  error)
    die "zv could not reach the vault: ${ZV_OUTPUT}"
    ;;
esac

read_zv_state
[ "$ZV_STATE" = ready ] \
  || die "Still can't access vault after auth: ${ZV_OUTPUT}"
