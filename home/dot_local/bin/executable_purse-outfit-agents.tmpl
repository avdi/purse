#!/bin/bash
# Outfit the installed AI agents: register MCP servers, install native plugins
# and Agent Skills packages, and register GitKraken MCP.
#
# chezmoi installs this to ~/.local/bin/purse-outfit-agents.
#
# Usage:
#   purse-outfit-agents                  # every agent present on this machine
#   purse-outfit-agents claude           # only Claude Code
#   purse-outfit-agents claude codex     # only those two
#
# Named agents are CLI commands, the same names purse-agent and dcsh use:
# `agy`, not `antigravity`; `cursor-agent`, not `cursor`. Naming one narrows
# every per-agent step to it, and reduces the shared tools its config points at
# — spec-kit, skills-ref — to a presence check instead of
# a forced reinstall. That is the door purse-agent uses when it installs an
# agent on first use: outfitting the other agents a container happens to hold
# would be somebody else's errand, paid for by whoever launched first.
#
# This is a deliberate, manually-invoked step — run it after purse-install-agents:
#   - It depends on the agent CLIs already being installed (claude, codex,
#     auggie, cursor-agent, ...), which happens via purse-install-agents.
#   - Registering servers and installing plugins across every detected agent
#     is too slow to run inline on every `chezmoi apply`.
#
# Only env-var REFERENCE strings are written into agent configs (e.g. literal
# ${GITHUB_PERSONAL_ACCESS_TOKEN}); secret values are never read or stored here.
#
# ~/.claude/settings.json is chezmoi's alone, from home/dot_claude/private_settings.json
# — hooks, permissionMode, enabled plugins and marketplaces all live there. Nothing here
# may write it. A jq pass that reaches the same result still reorders the keys, and
# chezmoi reads that as drift: the next `purse-pull` stops to ask, and where there is no
# TTY it aborts, leaving every file after `.claude/` unapplied.
#
# Declarative manifests (rendered inline by chezmoi):
#   MCP servers   : .chezmoidata/mcp-servers.yaml   (agents: {{ .mcpAgents | join ", " }})
#   Agent plugins : .chezmoidata/agent-plugins.yaml (agents: {{ .agentPlugins.agents | join ", " }})
# Re-running is safe (every step is idempotent).

set -euo pipefail
mkdir -p "$HOME/.local/bin"

have() { command -v "$1" >/dev/null 2>&1; }
warn() { echo "⚠️  $*" >&2; }

# --- scope -------------------------------------------------------------------
# The agent commands this run was asked for; empty means all of them.
requested_agents=("$@")

# Is <agent-command> in scope for this run? Callers still test `have`, so an
# agent that was asked for but isn't installed is skipped the way it always was.
wants() {
  [ "${#requested_agents[@]}" -eq 0 ] && return 0
  local requested
  for requested in "${requested_agents[@]}"; do
    [ "$requested" = "$1" ] && return 0
  done
  return 1
}

# True when this run is machine-wide. The shared tools use it to choose between
# upgrading themselves and merely making sure they exist.
outfitting_whole_machine() { [ "${#requested_agents[@]}" -eq 0 ]; }

# Names for the same agent in other tools' vocabularies. gk calls Claude Code
# `claude-cli` and reserves `claude` for the desktop app; skills.sh has its own
# spellings again. Empty means that tool has no counterpart for this agent.
# gk calls Claude Code `claude-cli` and reserves `claude` for the desktop app.
# cursor, copilot, opencode and antigravity are absent on purpose: chezmoi
# renders their MCP registries, GitKraken entry included, so gk has nothing to
# add there.
gk_platform_for() {
  case "$1" in
    claude) echo claude-cli ;;
    codex|gemini|kiro) echo "$1" ;;
    *) echo "" ;;
  esac
}

# skills.sh keeps its own vocabulary again, and rejects the whole install when a
# name is not in it — `--agent claude` is an error there; Claude Code is
# `claude-code`. `npx skills add --help` lists every name it accepts.
skills_target_for() {
  case "$1" in
    claude)       echo claude-code ;;
    agy)          echo antigravity-cli ;;
    auggie)       echo augment ;;
    copilot)      echo github-copilot ;;
    cursor-agent) echo cursor ;;
    codex|opencode|devin) echo "$1" ;;
    *) echo "" ;;
  esac
}

# jq upsert by server name into a JSON config file, preserving other entries.
# args: <cfg> <top-key> <server-name> <server-json>
jq_upsert() {
  local cfg="$1" key="$2" name="$3" server="$4" tmp
  mkdir -p "$(dirname "$cfg")"
  jq -e . "$cfg" >/dev/null 2>&1 || echo '{}' > "$cfg"
  tmp=$(mktemp)
  jq --arg k "$key" --arg name "$name" --argjson server "$server" \
     '.[$k] = ((.[$k] // {}) + {($name): $server})' \
     "$cfg" > "$tmp" && mv "$tmp" "$cfg"
}

# jq delete by server name from a JSON config file, leaving a file that never
# held it untouched: a rewrite reorders keys even when it removes nothing.
# args: <cfg> <top-key> <server-name>
jq_delete() {
  local cfg="$1" key="$2" name="$3" tmp
  jq -e --arg k "$key" --arg name "$name" ".[\$k] | has(\$name)" "$cfg" >/dev/null 2>&1 || return 0
  tmp=$(mktemp)
  jq --arg k "$key" --arg name "$name" "del(.[\$k][\$name])" "$cfg" > "$tmp" && mv "$tmp" "$cfg"
}

# --- per-agent MCP registration (each guarded by `have` in the driver) -------
# These rely on the manifest values declared as locals in outfit_mcp_servers
# (bash dynamic scoping makes them visible here).
#
# Args arrays expand as ${arr[@]+"${arr[@]}"} rather than "${arr[@]}": macOS
# ships bash 3.2, where an empty array under `set -u` is an unbound-variable
# error instead of zero words. A server declaring `args: []` aborted the whole
# run there under the plain form.
register_claude() {
  claude mcp remove github -s user >/dev/null 2>&1 || true
  claude mcp add --transport http github -s user "$gh_url" \
    --header "Authorization: $gh_bearer_dollar"
  claude mcp remove playwright -s user >/dev/null 2>&1 || true
  claude mcp add playwright -s user -- "$pw_cmd" ${pw_args[@]+"${pw_args[@]}"}
  claude mcp remove auggie -s user >/dev/null 2>&1 || true
  claude mcp add auggie -s user -- "$ag_cmd" ${ag_args[@]+"${ag_args[@]}"}
  claude mcp remove ripgrep -s user >/dev/null 2>&1 || true
  claude mcp add ripgrep -s user -- "$rg_cmd" ${rg_args[@]+"${rg_args[@]}"}
}

register_codex() {
  codex mcp remove github >/dev/null 2>&1 || true
  codex mcp add github --url "$gh_url" --bearer-token-env-var "$gh_token_var"
  codex mcp remove playwright >/dev/null 2>&1 || true
  codex mcp add playwright -- "$pw_cmd" ${pw_args[@]+"${pw_args[@]}"}
  codex mcp remove auggie >/dev/null 2>&1 || true
  codex mcp add auggie -- "$ag_cmd" ${ag_args[@]+"${ag_args[@]}"}
  codex mcp remove ripgrep >/dev/null 2>&1 || true
  codex mcp add ripgrep -- "$rg_cmd" ${rg_args[@]+"${rg_args[@]}"}
}

register_devin() {
  local cfg="$HOME/.config/devin/config.json"
  local gh
  gh=$(jq -n --arg url "$gh_url" --arg auth "$gh_bearer_dollar" \
        '{url:$url, transport:"http", headers:{Authorization:$auth}}')
  jq_upsert "$cfg" mcpServers github "$gh"
  local pw
  pw=$(jq -n --arg cmd "$pw_cmd" --argjson args "$pw_args_json" \
        '{command:$cmd, args:$args}')
  jq_upsert "$cfg" mcpServers playwright "$pw"
  local ag
  ag=$(jq -n --arg cmd "$ag_cmd" --argjson args "$ag_args_json" \
        '{command:$cmd, args:$args}')
  jq_upsert "$cfg" mcpServers auggie "$ag"
  local rg
  rg=$(jq -n --arg cmd "$rg_cmd" --argjson args "$rg_args_json" \
        '{command:$cmd, args:$args}')
  jq_upsert "$cfg" mcpServers ripgrep "$rg"
}

register_auggie() {
  # auggie does not expand ${VAR} in header values, so the github HTTP MCP
  # cannot be registered with an env-var token reference — it would send the
  # literal string and get a 400. Auggie has built-in GitHub context, so skip it.
  auggie mcp remove github >/dev/null 2>&1 || true
  local pw
  pw=$(jq -cn --arg cmd "$pw_cmd" --argjson args "$pw_args_json" \
        '{command:$cmd, args:$args}')
  auggie mcp add-json --replace -- playwright "$pw"
  local rg
  rg=$(jq -cn --arg cmd "$rg_cmd" --argjson args "$rg_args_json" \
        '{command:$cmd, args:$args}')
  auggie mcp add-json --replace -- ripgrep "$rg"
}

register_vscode() {
  local gh pw
  gh=$(jq -n --arg url "$gh_url" --arg auth "$gh_bearer_envcolon" \
        '{name:"github", type:"http", url:$url, headers:{Authorization:$auth}}')
  code --add-mcp "$gh"
  pw=$(jq -n --arg cmd "$pw_cmd" --argjson args "$pw_args_json" \
        '{name:"playwright", command:$cmd, args:$args}')
  code --add-mcp "$pw"
  local ag
  ag=$(jq -n --arg cmd "$ag_cmd" --argjson args "$ag_args_json" \
        '{name:"auggie", command:$cmd, args:$args}')
  code --add-mcp "$ag"
  local rg
  rg=$(jq -n --arg cmd "$rg_cmd" --argjson args "$rg_args_json" \
        '{name:"ripgrep", command:$cmd, args:$args}')
  code --add-mcp "$rg"
}

# --- per-agent MCP removal of a retired server (args: <server-name>) ---------
unregister_claude() { claude mcp remove "$1" -s user >/dev/null 2>&1 || true; }
unregister_codex()  { codex mcp remove "$1" >/dev/null 2>&1 || true; }
unregister_auggie() { auggie mcp remove "$1" >/dev/null 2>&1 || true; }
unregister_devin()  { jq_delete "$HOME/.config/devin/config.json" mcpServers "$1"; }

# `code --add-mcp` has no removing twin, so the user-profile registry is edited
# directly wherever this machine keeps one.
unregister_vscode() {
  local cfg
  for cfg in "$HOME/.config/Code/User/mcp.json" \
             "$HOME/Library/Application Support/Code/User/mcp.json"; do
    jq_delete "$cfg" servers "$1"
  done
}

# =============================================================================
# 1. MCP server shortlist — register the "always want these" servers into every
#    AI agent present on this machine.
# =============================================================================
outfit_mcp_servers() {
  if ! have jq; then
    warn "jq not found; skipping MCP server registration"
    return 0
  fi
  echo "→ MCP servers: registering shortlist into present agents..."

  # --- manifest values (parsed by chezmoi, not by this script) ---------------
  local gh_url='{{ (index .mcpServers "github").url }}'
  local gh_token_var='{{ index (index .mcpServers "github").requiresEnv 0 }}'
  local pw_cmd='{{ (index .mcpServers "playwright").command }}'
  local pw_args=({{ range (index .mcpServers "playwright").args }}'{{ . }}' {{ end }})  # bash array for `--` CLI forms
  local pw_args_json='{{ (index .mcpServers "playwright").args | toJson }}'             # JSON array for jq builders
  local ag_cmd='{{ (index .mcpServers "auggie").command }}'
  local ag_args=({{ range (index .mcpServers "auggie").args }}'{{ . }}' {{ end }})
  local ag_args_json='{{ (index .mcpServers "auggie").args | toJson }}'
  local rg_cmd='{{ (index .mcpServers "ripgrep").command }}'
  local rg_args=({{ range (index .mcpServers "ripgrep").args }}'{{ . }}' {{ end }})
  local rg_args_json='{{ (index .mcpServers "ripgrep").args | toJson }}'

  # Literal env-var reference strings (NOT expanded here — each agent expands
  # them at runtime). Syntax differs per agent.
  local gh_bearer_dollar="Bearer \${${gh_token_var}}"        # ${VAR}
  local gh_bearer_envcolon="Bearer \${env:${gh_token_var}}"  # ${env:VAR}
  local gh_bearer_brace="Bearer {env:${gh_token_var}}"       # {env:VAR}

  # An out-of-scope or missing agent is a normal, expected skip; a failed
  # registration warns but must not abort the run, or every later agent is
  # skipped too. Hence the `continue` guard and the per-agent `|| warn`.
  local agent command retired
  for agent in {{ .mcpAgents | join " " }}; do
    command="$(mcp_agent_command "$agent")"
    wants "$command" && have "$command" || continue
  "register_$agent" || warn "$agent MCP setup failed"
  for retired in {{ .retiredMcpServers | join " " }}; do
    "unregister_$agent" "$retired" || warn "$agent: removing retired MCP server $retired failed"
  done
done
}

# The CLI command behind a manifest name. Most agents answer to their own name;
# these three do not.
mcp_agent_command() {
  case "$1" in
    antigravity) echo agy ;;
    cursor)      echo cursor-agent ;;
    vscode)      echo code ;;
    *)           echo "$1" ;;
  esac
}

# =============================================================================
# 2. Retired plugins/marketplaces — uninstall anything dropped from the
#    agent-plugins.yaml shortlist so an existing machine actually converges to
#    the current manifest instead of only ever gaining entries. Driven by the
#    `agentPlugins.retired` manifest section; add an entry there (not here)
#    when retiring a plugin.
# =============================================================================
outfit_remove_retired_plugins() {
  echo "→ Retired plugins: uninstalling anything dropped from the shortlist..."
  {{ range $agent := .agentPlugins.agents }}
  {{- $verbs := index $.agentPlugins.verbs $agent }}
  if wants {{ $agent }} && have {{ $agent }}; then
    : # no-op so the body is never empty when this agent has no retired entries
    {{ range $.agentPlugins.retired.plugins }}
    {{- if has $agent .agents }}
    echo "→ {{ $agent }} plugin {{ $verbs.uninstall }} {{ .name }}@{{ .marketplace }}"
    {{ $agent }} plugin {{ $verbs.uninstall }} "{{ .name }}@{{ .marketplace }}" >/dev/null 2>&1 || true
    {{- end }}
    {{- end }}
    {{ range $.agentPlugins.retired.marketplaces }}
    {{- if has $agent .agents }}
    echo "→ {{ $agent }} plugin marketplace remove {{ .name }}"
    {{ $agent }} plugin marketplace remove "{{ .name }}" >/dev/null 2>&1 || true
    {{- end }}
    {{- end }}
  fi
  {{ end }}
}

# =============================================================================
# 3. Agent extensions — register marketplaces and install native plugins into
#    every agent that natively supports the Claude plugin/marketplace format
#    (Claude Code, Codex CLI, GitHub Copilot CLI, Auggie; see
#    .chezmoidata/agent-plugins.yaml for why VS Code/Cursor/Devin/Antigravity
#    are excluded). Built-in marketplaces are only auto-seeded on an interactive
#    first launch, so we register them explicitly here. Codex uses `plugin add`
#    where Claude/Copilot/Auggie use `plugin install`; otherwise identical.
#    Packages without a compatible native plugin are installed globally through
#    skills.sh for each detected fallback agent.
# =============================================================================
outfit_agent_plugins() {
  echo "→ Agent plugins: registering marketplaces and installing plugins..."
  {{ range $agent := .agentPlugins.agents }}
  {{- $verbs := index $.agentPlugins.verbs $agent }}
  if wants {{ $agent }} && have {{ $agent }}; then
    {{ range $.agentPlugins.marketplaces }}
    {{- if has $agent .agents }}
    echo "→ {{ $agent }} plugin marketplace add {{ .source }}"
    {{ $agent }} plugin marketplace add "{{ .source }}" || warn "{{ $agent }} marketplace add failed: {{ .source }}"
    {{- end }}
    {{- end }}
    {{ range $.agentPlugins.plugins }}
    {{- if has $agent .agents }}
    echo "→ {{ $agent }} plugin {{ $verbs.install }} {{ .name }}@{{ .marketplace }}"
    {{ $agent }} plugin {{ $verbs.install }} "{{ .name }}@{{ .marketplace }}" || warn "{{ $agent }} plugin install failed: {{ .name }}@{{ .marketplace }}"
    {{- end }}
    {{- end }}
  elif wants {{ $agent }}; then
    warn "{{ $agent }} CLI not found; skipping plugin installation"
  fi
  {{ end }}

  if ! have npx; then
    warn "npx not found; skipping skills.sh package installation"
    return 0
  fi

  {{ range .agentPlugins.skillPackages }}
  local skill_targets=()
  local skill_args=()
  {{ range .agents }}
  if wants {{ .command }} && have {{ .command }}; then
    skill_targets+=("{{ .target }}")
    skill_args+=(--agent "{{ .target }}")
  fi
  {{ end }}
  if [ "${#skill_targets[@]}" -gt 0 ]; then
    echo "→ skills.sh: installing {{ .source }} for ${skill_targets[*]}"
    npx --yes skills@latest add "{{ .source }}" --global --skill '*' ${skill_args[@]+"${skill_args[@]}"} --yes \
      || warn "skills.sh install failed: {{ .source }}"
  fi
  {{ end }}
}

# =============================================================================
# 4. Worktrunk plugin workaround — worktrunk issue #3417: Claude Code hardcodes
#    hooks/hooks.json as the plugin hook discovery path and ignores the "hooks"
#    field in plugin.json. Since commit 2677f05, worktrunk renamed the file to
#    claude-hooks.json, breaking hook discovery silently. Workaround: symlink
#    hooks.json → claude-hooks.json in every worktrunk plugin cache directory.
# =============================================================================
outfit_worktrunk_workaround() {
  wants claude || return 0
  local cache_base="$HOME/.claude/plugins/cache/worktrunk/worktrunk"
  if [ ! -d "$cache_base" ]; then
    return 0
  fi
  local fixed=0
  for hooks_dir in "$cache_base"/*/hooks; do
    [ -d "$hooks_dir" ] || continue
    if [ -f "$hooks_dir/claude-hooks.json" ] && [ ! -e "$hooks_dir/hooks.json" ]; then
      ln -sf claude-hooks.json "$hooks_dir/hooks.json"
      fixed=$((fixed + 1))
    fi
  done
  if [ "$fixed" -gt 0 ]; then
    echo "→ worktrunk workaround (#3417): symlinked hooks.json → claude-hooks.json in $fixed cache dir(s)"
  else
    echo "→ worktrunk workaround (#3417): already applied or not needed"
  fi
}

# =============================================================================
# 5. spec-kit (specify CLI) — Spec-Driven Development toolkit, installed as a
#    uv tool. Moved here from run_onchange_install-packages so initial setup
#    doesn't require uv to be available upfront.
# =============================================================================
outfit_spec_kit() {
  if ! have uv; then
    warn "uv not found; skipping spec-kit install"
    return 0
  fi
  # An agent-scoped run only needs this to exist. Upgrading it is the
  # machine-wide door's job, and `uv tool install --force` is not cheap.
  if ! outfitting_whole_machine && have specify; then
    return 0
  fi
  echo "→ spec-kit: installing/upgrading via uv tool..."
  # --link-mode=copy: in devcontainers the uv cache and install target often
  # sit on different filesystems (named Docker volume), so hardlinking fails.
  uv tool install --force --link-mode=copy specify-cli \
    --from git+https://github.com/github/spec-kit.git \
    || warn "spec-kit install failed"
}

# =============================================================================
# 6. skills-ref — reference library for Agent Skills, installed as a uv tool.
#    Provides the `skills-ref` CLI for validating, reading, and generating
#    <available_skills> XML blocks for agent prompts.
# =============================================================================
outfit_skills_ref() {
  if ! have uv; then
    warn "uv not found; skipping skills-ref install"
    return 0
  fi
  if ! outfitting_whole_machine && have skills-ref; then
    return 0
  fi
  echo "→ skills-ref: installing/upgrading via uv tool..."
  uv tool install --force --link-mode=copy skills-ref \
    --from "git+https://github.com/agentskills/agentskills.git#subdirectory=skills-ref" \
    || warn "skills-ref install failed"
}

# =============================================================================
# 7. Global skills — install the declarative shortlist from
#    .chezmoidata/global-skills.yaml into every present agent, globally.
#    Each entry maps to: npx skills add <source> --skill <skill> -g -y
#    Requires node/npx; skips gracefully if absent.
# =============================================================================
outfit_global_skills() {
  if ! have npx; then
    warn "npx not found; skipping global skills installation"
    return 0
  fi
  # Left to itself, skills.sh seeds every agent directory it can find. Scoped,
  # name the agents, so launching Claude does not furnish Codex as well.
  local agent_args=() agent target
  for agent in ${requested_agents[@]+"${requested_agents[@]}"}; do
    target="$(skills_target_for "$agent")"
    [ -n "$target" ] && agent_args+=(--agent "$target")
  done
  if ! outfitting_whole_machine && [ "${#agent_args[@]}" -eq 0 ]; then
    return 0
  fi

  echo "→ global skills: installing shortlist..."
  {{ range .globalSkills -}}
  echo "  • {{ .description }} ({{ .source }}{{ if .skill }} --skill {{ .skill }}{{ end }})"
  npx --yes skills add "{{ .source }}"{{ if .skill }} --skill "{{ .skill }}"{{ end }} -g -y ${agent_args[@]+"${agent_args[@]}"} \
    || warn "skills install failed: {{ .source }}{{ if .skill }} --skill {{ .skill }}{{ end }}"
  {{ end -}}
}

# =============================================================================
# 8. GitKraken MCP — gk ships its own multi-client installer. `gk mcp install
#    --all` detects every installed MCP client and writes a stdio entry that
#    runs `gk mcp`. Authentication (`gk auth login`) is only needed when the
#    server runs, not to write the config, so this is safe non-interactively.
# =============================================================================
outfit_gitkraken_mcp() {
  if ! have gk; then
    warn "gk (GitKraken CLI) not found; skipping GitKraken MCP setup"
    return 0
  fi
  # --all still covers the editors and desktop clients purse does not manage.
  # It also visits cursor, copilot, opencode and antigravity, whose registries
  # chezmoi renders — including a GitKraken entry in the exact shape gk writes,
  # so gk finds a match there and leaves the file alone.
  if outfitting_whole_machine; then
    echo "→ GitKraken MCP: installing into all detected clients..."
    gk mcp install --all || warn "gk mcp install failed"
    return 0
  fi

  local platforms=() agent platform
  for agent in "${requested_agents[@]}"; do
    platform="$(gk_platform_for "$agent")"
    [ -n "$platform" ] && platforms+=("$platform")
  done
  [ "${#platforms[@]}" -gt 0 ] || return 0

  echo "→ GitKraken MCP: installing into ${platforms[*]}..."
  gk mcp install "${platforms[@]}" || warn "gk mcp install failed"
}

# --- run ---------------------------------------------------------------------
# MCP servers, agent plugins, and GitKraken MCP are internally resilient
# (per-item `|| warn`) and run first.
# Every step below consults `wants`, so naming agents narrows all of them at
# once rather than each caller remembering which steps belong to whom.
if ! outfitting_whole_machine; then
  echo "→ scope: ${requested_agents[*]}"
fi

outfit_mcp_servers
outfit_remove_retired_plugins
outfit_agent_plugins
outfit_worktrunk_workaround
outfit_spec_kit
outfit_skills_ref
outfit_global_skills
outfit_gitkraken_mcp

# Scrub any PATH lines injected into ~/.bashrc / ~/.profile by tool installers
# (known offenders: antigravity CLI). env.sh owns PATH setup; duplicates here
# re-bury the purse shims dir behind ~/.local/bin.
purse-scrub-path-stompers

echo
if outfitting_whole_machine; then
  echo "✅ Agents outfitted: MCP servers, agent plugins, spec-kit, skills-ref, global skills, GitKraken MCP."
else
  echo "✅ Outfitted ${requested_agents[*]}: MCP servers, agent plugins, global skills, GitKraken MCP."
fi
