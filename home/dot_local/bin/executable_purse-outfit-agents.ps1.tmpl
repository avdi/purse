{{- if eq .chezmoi.os "windows" -}}
# Outfit the installed AI agents (Windows): install native plugins and Agent
# Skills packages, and register GitKraken MCP.
#
# chezmoi installs this to ~/.local/bin/purse-outfit-agents.ps1.
#
# Run manually, after purse-install-agents.ps1. Full declarative MCP-server
# shortlist registration (as done in the Unix purse-outfit-agents) is not yet
# wired up on Windows.
#
# Re-running is safe (idempotent).

$ErrorActionPreference = 'Stop'
[Net.ServicePointManager]::SecurityProtocol = `
    [Net.SecurityProtocolType]::Tls12 -bor [Net.SecurityProtocolType]::Tls13

function Test-Command($Name) {
    return [bool](Get-Command $Name -ErrorAction SilentlyContinue)
}

function Invoke-CheckedCommand($Command, [string[]]$Arguments) {
    & $Command @Arguments
    if ($LASTEXITCODE -ne 0) {
        throw "$Command exited with status $LASTEXITCODE"
    }
}

Write-Host "-> Retired plugins: uninstalling anything dropped from the shortlist..." -ForegroundColor Cyan
{{ range $agent := .agentPlugins.agents }}
if (Test-Command '{{ $agent }}') {
    {{ range $.agentPlugins.retired.plugins }}
    {{- if has $agent .agents }}
    try { Invoke-CheckedCommand '{{ $agent }}' @('plugin', 'uninstall', '{{ .name }}@{{ .marketplace }}') } catch {}
    {{- end }}
    {{- end }}
    {{ range $.agentPlugins.retired.marketplaces }}
    {{- if has $agent .agents }}
    try { Invoke-CheckedCommand '{{ $agent }}' @('plugin', 'marketplace', 'remove', '{{ .name }}') } catch {}
    {{- end }}
    {{- end }}
}
{{ end }}

# context-mode wired a SessionStart hook straight into settings.json instead
# of shipping it in the plugin's own hooks.json, so `plugin uninstall` above
# doesn't clean it up. Scrub the dangling entry and the hook file itself
# (chezmoi already stopped deploying it once removed from the source state).
$ClaudeSettings = "$env:USERPROFILE\.claude\settings.json"
if ((Test-Command 'jq') -and (Test-Path $ClaudeSettings)) {
    $Filtered = jq '.hooks.SessionStart = ((.hooks.SessionStart // []) | map(select([.hooks[]?.command // "" | contains("context-mode-cache-heal")] | any | not))) | if (.hooks.SessionStart | length) == 0 then del(.hooks.SessionStart) else . end' $ClaudeSettings
    if ($LASTEXITCODE -eq 0) { Set-Content -Path $ClaudeSettings -Value $Filtered }
}
Remove-Item "$env:USERPROFILE\.claude\hooks\context-mode-cache-heal.mjs" -Force -ErrorAction SilentlyContinue

Write-Host "-> Agent plugins: registering marketplaces and installing plugins..." -ForegroundColor Cyan
{{ range $agent := .agentPlugins.agents }}
if (Test-Command '{{ $agent }}') {
    {{ range $.agentPlugins.marketplaces }}
    {{- if has $agent .agents }}
    try {
        Invoke-CheckedCommand '{{ $agent }}' @('plugin', 'marketplace', 'add', '{{ .source }}')
    } catch {
        Write-Warning "{{ $agent }} marketplace add failed: {{ .source }}: $_"
    }
    {{- end }}
    {{- end }}
    {{ range $.agentPlugins.plugins }}
    {{- if has $agent .agents }}
    try {
        Invoke-CheckedCommand '{{ $agent }}' @('plugin', '{{ if eq $agent "codex" }}add{{ else }}install{{ end }}', '{{ .name }}@{{ .marketplace }}')
    } catch {
        Write-Warning "{{ $agent }} plugin install failed: {{ .name }}@{{ .marketplace }}: $_"
    }
    {{- end }}
    {{- end }}
}
{{ end }}

if (Test-Command 'npx') {
    {{ range .agentPlugins.skillPackages }}
    $SkillTargets = @()
    $SkillArguments = @()
    {{ range .agents }}
    if (Test-Command '{{ .command }}') {
        $SkillTargets += '{{ .target }}'
        $SkillArguments += @('--agent', '{{ .target }}')
    }
    {{ end }}
    if ($SkillTargets.Count -gt 0) {
        Write-Host "-> skills.sh: installing {{ .source }} for $($SkillTargets -join ', ')"
        try {
            Invoke-CheckedCommand 'npx' (@('--yes', 'skills@latest', 'add', '{{ .source }}', '--global', '--skill', '*') + $SkillArguments + @('--yes'))
        } catch {
            Write-Warning "skills.sh install failed: {{ .source }}: $_"
        }
    }
    {{ end }}
} else {
    Write-Warning "npx not found; skipping skills.sh package installation."
}

# codebase-memory-mcp is retired. Remove the binary this script used to
# install, the user-PATH entry it added, and any Claude Code registration left
# by the tool's own installer; each step is a no-op once done.
$CbmDir = "$env:LOCALAPPDATA\Programs\codebase-memory-mcp"
if (Test-Path $CbmDir) {
    Write-Host "-> codebase-memory-mcp (retired): removing $CbmDir" -ForegroundColor Cyan
    Remove-Item -Recurse -Force $CbmDir -ErrorAction SilentlyContinue
}
$UserPath = [Environment]::GetEnvironmentVariable('PATH', 'User')
if ($UserPath -and $UserPath -like "*$CbmDir*") {
    $Kept = ($UserPath -split ';' | Where-Object { $_ -and $_ -ne $CbmDir }) -join ';'
    [Environment]::SetEnvironmentVariable('PATH', $Kept, 'User')
}
if (Test-Command 'claude') {
    claude mcp remove codebase-memory-mcp -s user *> $null
}

# GitKraken MCP -- gk ships its own multi-client installer. `gk mcp install
# --all` detects every installed MCP client and writes a stdio entry that runs
# `gk mcp`. Auth (`gk auth login`) is only needed when the server runs, not to
# write the config, so this is safe non-interactively.
if (Get-Command gk -ErrorAction SilentlyContinue) {
    Write-Host "-> GitKraken MCP: installing into all detected clients..." -ForegroundColor Cyan
    try {
        gk mcp install --all
    } catch {
        Write-Warning "gk mcp install failed: $_"
    }
} else {
    Write-Warning "gk (GitKraken CLI) not found; skipping GitKraken MCP setup."
}

Write-Host ""
Write-Host "Agents outfitted: plugins, skills, GitKraken MCP." -ForegroundColor Green
{{- end -}}
