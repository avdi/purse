#!/usr/bin/env bash
# dcbridge — keep each running devcontainer wired to the host: its ports
# bridged, the host's secrets readable by every shell inside it, and the host's
# herdr reachable by the agents running in it.
#
# Ports. dbr forwards a devcontainer's listening ports to the host so
# `localhost:<port>` opens in a host browser. That takes two daemons: `dbr
# host-daemon` out here, and `dbr container-daemon` inside each container,
# connected to the first over a shared auth token. The purse devcontainer shim
# injects the dbr *feature*, but a feature only lands on a `devcontainer up`
# that rebuilds — so a container started by VS Code, by `docker compose up`, or
# before the feature was adopted has no container daemon, and nothing notices.
# The symptom is a port that listens perfectly well inside the container and
# refuses connections outside.
#
# Secrets. The same shim forwards the host's resolved vault secrets as
# --remote-env, which decorates `devcontainer exec` and the lifecycle commands
# and nothing else. A shell reached any other way — over the container's sshd,
# which is every `herdr --remote` pane, or through plain `docker exec` — is
# forked from a daemon the CLI never touched, and inherits none of them. This
# drops the same values on tmpfs inside each container, where env.sh sources
# them. tmpfs so they die with the container rather than persisting in the
# named volume that holds the rest of ~/.config.
#
# herdr. herdr reads an agent's identity and state straight off the pane's
# terminal, which a containerised agent supplies as well as a host one does.
# Its control socket is the part that stops at the container wall, so the
# agent's integration hook — the thing that reports the native session id — has
# nothing to talk to. `herdr-bridge` fronts that socket on a loopback port out
# here; this pushes the matching relay into each container and keeps it up.
#
# All three are one problem: the shim can only decorate containers it creates
# or execs into, and this reconciles every container that got in another way.
#
#   dcbridge --install           # run the reconciler as a systemd user service
#   dcbridge --status            # what is bridged right now
#   dcbridge                     # reconcile once
#   dcbridge --watch             # reconcile on an interval, in the foreground
#   dcbridge --refresh-secrets   # push secrets now, after `purse-setup-secrets`
#   dcbridge --uninstall         # stop and remove the service
#
# --install is what makes this stop being something to remember.
#
# DCBRIDGE_POLL_SECONDS sets the watch interval (default 15).
# DCBRIDGE_SYNC_SECRETS=0 opts out of the secrets half entirely.
# DCBRIDGE_SYNC_HERDR=0 opts out of the herdr tunnel.
#
# Exit status: 1 when --status finds the bridge down, 2 for a bad invocation,
# 127 when dbr or docker is missing.

set -euo pipefail

POLL_SECONDS="${DCBRIDGE_POLL_SECONDS:-15}"
TOKEN_FILE="${DCBRIDGE_AUTH_TOKEN_FILE:-$HOME/.config/dbr/auth-token}"
CONTAINER_LOG=/tmp/dbr-container.log
SERVICE_NAME="dcbridge.service"
UNIT_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$SERVICE_NAME"
LOOKUP_LIB="$HOME/.local/share/purse/lib/devcontainer-lookup.sh"
HOST_SECRETS_FILE="${PURSE_SECRETS_FILE:-$HOME/.config/shell/secrets.sh}"
CONTAINER_SECRETS_FILE=/dev/shm/purse-secrets.sh
HERDR_TOKEN_FILE="${HERDR_BRIDGE_AUTH_TOKEN_FILE:-$HOME/.config/herdr-bridge/auth-token}"
HERDR_RELAY_SOURCE="$HOME/.local/share/purse/lib/herdr-relay.py"
CONTAINER_HERDR_RELAY=/dev/shm/herdr-relay.py
CONTAINER_HERDR_TOKEN=/dev/shm/herdr-bridge-token
CONTAINER_HERDR_SOCKET=/dev/shm/herdr.sock
CONTAINER_HERDR_LOG=/tmp/herdr-relay.log

usage() { sed -n '2,49p' "$0" | sed 's/^# \{0,1\}//'; }
die() { printf 'dcbridge: %s\n' "$*" >&2; exit "${2:-2}"; }
log() { printf 'dcbridge: %s\n' "$*"; }

[[ -r "$LOOKUP_LIB" ]] || die "missing $LOOKUP_LIB"
# shellcheck source=../share/purse/lib/devcontainer-lookup.sh
. "$LOOKUP_LIB"

have() { command -v "$1" > /dev/null 2>&1; }

# ── the host side ────────────────────────────────────────────────────────────

# The token both daemons must agree on. dbr writes it on first `ensure`; a
# container that generates its own instead is rejected, which shows up in the
# host log as "authentication failed: invalid token" and nowhere else.
host_token() {
  [[ -r "$TOKEN_FILE" ]] || return 1
  tr -d '[:space:]' < "$TOKEN_FILE"
}

host_daemon_running() {
  pgrep -f 'dbr host-daemon' > /dev/null 2>&1
}

# --host 127.0.0.1 avoids dbr's default host.docker.internal probe, which on WSL
# resolves to the Windows LAN IP and stalls past the 5s spawn deadline. The
# daemon still binds 0.0.0.0, which is how containers reach it.
ensure_host_daemon() {
  host_daemon_running && return 0
  log "starting host daemon"
  dbr ensure --host 127.0.0.1 > /dev/null 2>&1 || {
    log "could not start the host daemon; see ~/.config/dbr/daemon.log"
    return 1
  }
}

# ── the container side ───────────────────────────────────────────────────────

container_name() {
  docker inspect "$1" --format '{{.Name}}' 2>/dev/null | sed 's#^/##'
}

# `docker exec` with no shell: a login shell here would drag in the container's
# whole profile, and one broken rc file would take the bridge down with it.
in_container() { # in_container ID CMD...
  local id="$1"; shift
  docker exec "$id" "$@" 2>/dev/null
}

# `|| true` on these two: pgrep and command -v report "nothing matched" with a
# non-zero status, which under pipefail would abort the whole reconcile pass on
# the entirely normal case of a container that has no daemon yet.
container_dbr_path() {
  in_container "$1" sh -c 'command -v dbr' | tr -d '\r\n' || true
}

container_daemon_running() {
  in_container "$1" pgrep -f 'dbr container-daemon' > /dev/null 2>&1
}

# A `dbr ensure` run inside a container starts a *host* daemon there — it sees no
# Docker socket, concludes it is a host, and binds 19285/19286 in the container's
# own namespace. It bridges nothing, and it occupies the ports the real container
# daemon reports on. purse-install-extras used to do exactly this.
stray_host_daemon_pid() {
  in_container "$1" pgrep -f 'dbr host-daemon' | head -1 | tr -d '\r\n' || true
}

start_container_daemon() { # start_container_daemon ID TOKEN
  local id="$1" token="$2" dbr_path
  dbr_path="$(container_dbr_path "$id")"
  if [[ -z "$dbr_path" ]]; then
    log "$(container_name "$id"): no dbr binary inside — recreate it with \`dc up\` to pick up the injected feature"
    return 1
  fi
  docker exec -d -e "DCBRIDGE_AUTH_TOKEN=$token" "$id" \
    "$dbr_path" container-daemon --log-file "$CONTAINER_LOG" 2>/dev/null || return 1
}

# ── the secrets tunnel ───────────────────────────────────────────────────────

# purse-setup-secrets already writes a self-contained, shell-quoted file, so the
# payload is that file verbatim with a fingerprint stapled on. Shipping the file
# rather than re-exporting from our own environment is what lets this run under
# systemd, which never sources a login profile — and it means a secret *removed*
# from the vault disappears from containers too, which re-exporting would miss.
secrets_available() {
  [[ "${DCBRIDGE_SYNC_SECRETS:-1}" != "0" && -r "$HOST_SECRETS_FILE" ]]
}

secrets_fingerprint() {
  sha256sum < "$HOST_SECRETS_FILE" | cut -d' ' -f1
}

secrets_payload() {
  printf '# purse-secrets %s\n' "$(secrets_fingerprint)"
  cat "$HOST_SECRETS_FILE"
}

container_secrets_fingerprint() {
  in_container "$1" sed -n '1s/^# purse-secrets //p' "$CONTAINER_SECRETS_FILE" \
    | tr -d '\r\n' || true
}

# Values arrive on stdin, never in argv: a `docker exec` command line shows up
# in `docker inspect` and in every process listing on the host. umask before the
# redirect, so the file is never briefly world-readable.
push_secrets() { # push_secrets ID
  secrets_payload \
    | docker exec -i "$1" sh -c "umask 077 && cat > '$CONTAINER_SECRETS_FILE'" 2>/dev/null
}

# Only writes when the fingerprint differs, so a steady state is one cheap read
# per container per pass rather than a rewrite.
sync_secrets() { # sync_secrets ID NAME
  local id="$1" name="$2" existing
  secrets_available || return 0
  existing="$(container_secrets_fingerprint "$id")"
  [[ "$existing" == "$(secrets_fingerprint)" ]] && return 0
  if push_secrets "$id"; then
    log "$name: secrets ${existing:+re}synced"
  else
    log "$name: could not write $CONTAINER_SECRETS_FILE"
  fi
}

# After `purse-setup-secrets`, when waiting out the poll interval is annoying.
refresh_secrets() {
  secrets_available || die "no readable secrets at $HOST_SECRETS_FILE — run \`purse-setup-secrets\`" 1

  local id name pushed=0
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    name="$(container_name "$id")"
    if push_secrets "$id"; then
      log "$name: secrets pushed"
      pushed=$((pushed + 1))
    else
      log "$name: could not write $CONTAINER_SECRETS_FILE"
    fi
  done < <(devcontainer_all)

  log "$pushed container(s) updated"
  log "new shells pick them up; in an existing one: . ~/.config/shell/env.sh"
}

# ── the herdr tunnel ─────────────────────────────────────────────────────────

# Nothing here is required for a containerised agent to show up in herdr — the
# pane's terminal already carries that. This buys the one thing the terminal
# cannot: the agent's own session id, reported by its integration hook, which is
# what lets herdr resume the conversation after a server restart.
herdr_tunnel_available() {
  [[ "${DCBRIDGE_SYNC_HERDR:-1}" != "0" ]] &&
    have herdr-bridge &&
    [[ -r "$HERDR_RELAY_SOURCE" ]]
}

ensure_herdr_daemon() {
  herdr-bridge ensure > /dev/null 2>&1 || {
    log "could not start herdr-bridge; see ~/.config/herdr-bridge/daemon.log"
    return 1
  }
}

herdr_relay_fingerprint() {
  sha256sum < "$HERDR_RELAY_SOURCE" | cut -d' ' -f1
}

# The same stamp-and-compare the secrets half uses, so a steady state costs one
# cheap read per container per pass instead of a rewrite.
herdr_relay_payload() {
  printf '# herdr-relay %s\n' "$(herdr_relay_fingerprint)"
  cat "$HERDR_RELAY_SOURCE"
}

container_herdr_relay_fingerprint() { # container_herdr_relay_fingerprint ID
  in_container "$1" sed -n '1s/^# herdr-relay //p' "$CONTAINER_HERDR_RELAY" \
    | tr -d '\r\n' || true
}

container_herdr_relay_running() { # container_herdr_relay_running ID
  in_container "$1" pgrep -f "$CONTAINER_HERDR_RELAY" > /dev/null 2>&1
}

container_has_python() { # container_has_python ID
  in_container "$1" sh -c 'command -v python3' > /dev/null 2>&1
}

# Token on stdin for the same reason the secrets are: a `docker exec` command
# line is visible in `docker inspect` and in every host process listing.
push_herdr_relay() { # push_herdr_relay ID
  herdr_relay_payload \
    | docker exec -i "$1" sh -c "umask 077 && cat > '$CONTAINER_HERDR_RELAY'" 2>/dev/null || return 1
  herdr-bridge token \
    | docker exec -i "$1" sh -c "umask 077 && cat > '$CONTAINER_HERDR_TOKEN'" 2>/dev/null
}

start_container_herdr_relay() { # start_container_herdr_relay ID
  docker exec -d "$1" sh -c \
    "python3 '$CONTAINER_HERDR_RELAY' --socket '$CONTAINER_HERDR_SOCKET' --token-file '$CONTAINER_HERDR_TOKEN' >> '$CONTAINER_HERDR_LOG' 2>&1" \
    2>/dev/null
}

# A relay running against a stale copy of the script or a rotated token is
# worse than none, because it answers. Restart it whenever the push changed.
sync_herdr_tunnel() { # sync_herdr_tunnel ID NAME
  local id="$1" name="$2" existing pushed=0

  herdr_tunnel_available || return 0
  if ! container_has_python "$id"; then
    return 0
  fi

  existing="$(container_herdr_relay_fingerprint "$id")"
  if [[ "$existing" != "$(herdr_relay_fingerprint)" ]]; then
    if push_herdr_relay "$id"; then
      pushed=1
    else
      log "$name: could not write $CONTAINER_HERDR_RELAY"
      return 1
    fi
  fi

  if [[ "$pushed" -eq 1 ]] && container_herdr_relay_running "$id"; then
    in_container "$id" pkill -f "$CONTAINER_HERDR_RELAY" || true
  fi

  container_herdr_relay_running "$id" && return 0

  if start_container_herdr_relay "$id"; then
    log "$name: herdr relay ${existing:+re}started"
  else
    log "$name: could not start the herdr relay"
    return 1
  fi
}

# ── reconciliation ───────────────────────────────────────────────────────────

# The two halves fail independently on purpose: a dbr that will not start must
# not also cut off secrets, and an unwritable container must not stop the ports.
reconcile() {
  local token="" id name stray seen=0 bridged=0

  if ensure_host_daemon; then
    token="$(host_token)" ||
      log "no auth token at $TOKEN_FILE — run \`dbr ensure\` once to create it"
  fi

  herdr_tunnel_available && ensure_herdr_daemon || true

  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    seen=$((seen + 1))
    name="$(container_name "$id")"

    sync_secrets "$id" "$name"
    sync_herdr_tunnel "$id" "$name" || true

    [[ -n "$token" ]] || continue

    stray="$(stray_host_daemon_pid "$id")"
    if [[ -n "$stray" ]]; then
      log "$name: stopping a host daemon that should not be in a container (pid $stray)"
      in_container "$id" kill "$stray" || true
    fi

    if container_daemon_running "$id"; then
      bridged=$((bridged + 1))
      continue
    fi

    if start_container_daemon "$id" "$token"; then
      log "$name: container daemon started"
      bridged=$((bridged + 1))
    fi
  done < <(devcontainer_all)

  log "$bridged/$seen devcontainer(s) bridged"
  [[ -n "$token" && "$bridged" -eq "$seen" ]]
}

watch_loop() {
  log "reconciling every ${POLL_SECONDS}s (Ctrl-C to stop)"
  while true; do
    reconcile || true
    sleep "$POLL_SECONDS"
  done
}

# ── status ───────────────────────────────────────────────────────────────────

host_listening_ports() {
  ss -ltnH 2> /dev/null | awk '{ n = split($4, a, ":"); print a[n] }' | sort -nu
}

# Read the container's own /proc rather than assuming `ss` is installed in it.
container_listening_ports() {
  in_container "$1" cat /proc/net/tcp /proc/net/tcp6 \
    | awk '$4 == "0A" { split($2, a, ":"); print strtonum("0x" a[2]) }' \
    | sort -nu || true
}

report_status() {
  local id name ports host_ports bridged unbridged port ok=0

  if host_daemon_running; then
    echo "host daemon:  up"
  else
    echo "host daemon:  DOWN"
  fi

  if ! herdr_tunnel_available; then
    echo "herdr bridge: off"
  elif herdr-bridge status > /dev/null 2>&1; then
    echo "herdr bridge: up"
  else
    echo "herdr bridge: DOWN"
    ok=1
  fi

  if have systemctl && [[ -f "$UNIT_PATH" ]]; then
    printf 'service:      %s / %s\n' \
      "$(systemctl --user is-active "$SERVICE_NAME" 2> /dev/null || true)" \
      "$(systemctl --user is-enabled "$SERVICE_NAME" 2> /dev/null || true)"
  else
    echo "service:      not installed — run 'dcbridge --install'"
  fi

  host_ports="$(host_listening_ports)"

  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    name="$(container_name "$id")"
    echo
    if container_daemon_running "$id"; then
      printf '%s: container daemon up\n' "$name"
    else
      printf '%s: container daemon DOWN\n' "$name"
      ok=1
    fi

    if ! secrets_available; then
      printf '  secrets:     not tunnelled (no %s)\n' "$HOST_SECRETS_FILE"
    elif [[ "$(container_secrets_fingerprint "$id")" == "$(secrets_fingerprint)" ]]; then
      printf '  secrets:     in sync\n'
    else
      printf '  secrets:     STALE — run `dcbridge --refresh-secrets`\n'
      ok=1
    fi

    if ! herdr_tunnel_available; then
      printf '  herdr:       off\n'
    elif ! container_has_python "$id"; then
      printf '  herdr:       no python3 in this container\n'
    elif container_herdr_relay_running "$id"; then
      printf '  herdr:       relay up on %s\n' "$CONTAINER_HERDR_SOCKET"
    else
      printf '  herdr:       relay DOWN\n'
      ok=1
    fi

    ports="$(container_listening_ports "$id")"
    bridged=""; unbridged=""
    for port in $ports; do
      if grep -qx "$port" <<< "$host_ports"; then
        bridged="${bridged:+$bridged }$port"
      else
        unbridged="${unbridged:+$unbridged }$port"
        ok=1
      fi
    done
    printf '  on host:    %s\n' "${bridged:-none}"
    printf '  not bridged: %s\n' "${unbridged:-none}"
  done < <(devcontainer_all)

  return "$ok"
}

# ── the user service ─────────────────────────────────────────────────────────

install_service() {
  have systemctl || die "systemctl not found — no systemd user session to install into" 127

  mkdir -p "$(dirname "$UNIT_PATH")"
  cat > "$UNIT_PATH" << EOF
# Generated by \`dcbridge --install\`. Regenerate with that command.
[Unit]
Description=Keep devcontainer-bridge daemons running for every devcontainer
After=default.target

[Service]
ExecStart=%h/.local/bin/dcbridge --watch
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
EOF

  systemctl --user daemon-reload
  systemctl --user enable --now "$SERVICE_NAME"

  # Without lingering the service lives only as long as a login session does,
  # which puts this back to "works until I close the terminal".
  if have loginctl; then
    loginctl enable-linger "$USER" > /dev/null 2>&1 \
      || echo "note: lingering not enabled; the bridge starts at login rather than at boot" >&2
  fi

  echo "installed $UNIT_PATH"
  echo "logs: journalctl --user -u $SERVICE_NAME -f"
}

uninstall_service() {
  have systemctl || die "systemctl not found" 127
  systemctl --user disable --now "$SERVICE_NAME" > /dev/null 2>&1 || true
  rm -f "$UNIT_PATH"
  systemctl --user daemon-reload
  echo "removed $SERVICE_NAME"
}

# ── dispatch ─────────────────────────────────────────────────────────────────

action=reconcile
for arg in "$@"; do
  case "$arg" in
    --watch) action=watch ;;
    --status) action=status ;;
    --install) action=install ;;
    --uninstall) action=uninstall ;;
    --refresh-secrets) action=refresh-secrets ;;
    -h | --help) usage; exit 0 ;;
    *) die "unknown option: $arg" ;;
  esac
done

have docker || die "docker not found" 127
# Only the port half needs dbr; pushing secrets to a container does not, and
# refusing to do it on a host without dbr installed would be gratuitous.
case "$action" in
  reconcile | watch | status)
    have dbr || die "dbr not found — run \`purse-install-extras\`" 127
    ;;
esac

case "$action" in
  reconcile) reconcile ;;
  watch) watch_loop ;;
  status) report_status || exit 1 ;;
  install) install_service ;;
  uninstall) uninstall_service ;;
  refresh-secrets) refresh_secrets ;;
esac
