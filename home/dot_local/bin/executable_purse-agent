#!/usr/bin/env bash
# purse-agent — run an AI coding agent CLI, outfitting it the first time you
# reach for it.
#
# Usage:
#   purse-agent <agent-command> [args...]
#
#   purse-agent claude              # same as `claude`, plus the job below
#   purse-agent codex --help
#
# The shell wrappers in ~/.config/shell/aliases.sh route every known agent
# command through here, and `dcsh --agent` runs it as the container-side entry
# point.
#
# Provisioning, everywhere. An agent missing from PATH that purse has a recipe
# for is installed at the moment you reach for it, and outfitted after — that
# agent alone, never every agent the machine happens to hold. A container
# therefore carries what you actually used in it, rather than everything purse
# knows, installed at build time against the chance.
#
# Outfitting repeats when it should. The stamp on tmpfs carries the fingerprint
# of the outfitting that wrote it, so a new container outfits, a changed
# manifest outfits, and nothing else does.
#
# Every step degrades to running the agent. A failed install, a missing
# purse-outfit-agents — each warns and falls through, because refusing to start
# the agent is always the worse failure.
#
# On herdr: a containerised agent is only visible to it when the agent is named
# on the host before exec, which is `dcsh --agent` / `dcclaude`. Typed at a
# container prompt it cannot be — see the herdr section below, which says so
# rather than leaving you to wonder.
#
# PURSE_AGENT=0 skips provisioning. PURSE_AGENT_HERDR=0 silences the herdr note.

set -uo pipefail

command="${1:-}"
if [ -z "$command" ]; then
  echo "usage: purse-agent <agent-command> [args...]" >&2
  exit 2
fi
shift

warn() { printf 'purse-agent: %s\n' "$*" >&2; }
have() { command -v "$1" > /dev/null 2>&1; }

# Hand straight over when asked to stand down, or when this is already running
# inside an agent purse-agent started — an agent that shells out and reaches
# for another one should not re-enter provisioning or claim the pane twice.
if [ "${PURSE_AGENT:-1}" = "0" ] || [ -n "${PURSE_AGENT_ACTIVE:-}" ]; then
  exec "$command" "$@"
fi

lib="$HOME/.local/share/purse/lib/herdr-agents.sh"
if [ -r "$lib" ]; then
  # shellcheck source=../share/purse/lib/herdr-agents.sh
  . "$lib"
else
  warn "missing $lib — running $command unchanged"
  exec "$command" "$@"
fi

in_container() {
  [ -n "${REMOTE_CONTAINERS:-}${CODESPACES:-}${DEVCONTAINER:-}" ] || [ -f /.dockerenv ]
}

# ── provisioning ─────────────────────────────────────────────────────────────

# Install the agent if it isn't here and purse knows how. Returns 0 when an
# install actually ran, so the caller can outfit only what it just created.
install_if_missing() {
  have "$command" && return 1

  local recipe
  recipe="$(purse_agent_install_command "$command")"
  [ -n "$recipe" ] || return 1

  printf 'purse-agent: %s is not installed here — installing it now.\n' "$command" >&2

  # npm's default global prefix needs root; purse puts global installs under
  # ~/.local instead, which is already on PATH. Set it before the first install
  # rather than assuming purse-install-agents has run in this container.
  case "$recipe" in
    npm\ *)
      if have npm; then
        npm config set prefix "$HOME/.local" > /dev/null 2>&1 || true
      fi
      ;;
  esac

  if ! eval "$recipe" >&2; then
    warn "installing $command failed — trying to run it anyway"
    return 1
  fi

  # A fresh binary in a directory bash already searched is invisible until the
  # command hash is dropped.
  hash -r 2> /dev/null || true
  return 0
}

# Register MCP servers, plugins and hooks — for this agent alone. Named on the
# command line, purse-outfit-agents touches only the agent asked for, plus the
# shared tools that agent's config points at. Outfitting every agent a container
# happens to hold is somebody else's errand.
outfit() {
  have purse-outfit-agents || return 0

  printf 'purse-agent: outfitting %s (MCP servers, plugins, hooks)...\n' "$command" >&2
  if purse-outfit-agents "$command" >&2; then
    printf '%s\n' "$(outfit_fingerprint)" > "$1" 2> /dev/null || true
  else
    warn "outfitting failed — run \`purse-outfit-agents $command\` by hand to finish it"
  fi
}

# What this machine's outfitting currently amounts to, in one string. chezmoi
# renders every manifest — MCP servers, agent plugins, global skills — inline
# into purse-outfit-agents, so the rendered script's digest is the whole
# definition. Change any manifest and this changes with it.
outfit_fingerprint() {
  local script
  script="$(command -v purse-outfit-agents 2> /dev/null)" || return 0
  if have sha256sum; then
    sha256sum "$script" 2> /dev/null | cut -d' ' -f1
  elif have shasum; then
    shasum -a 256 "$script" 2> /dev/null | cut -d' ' -f1
  fi
}

provision() {
  # tmpfs, so a rebuilt image outfits again rather than trusting a stamp left
  # in the named volume that carries ~/.config between containers. It holds the
  # fingerprint of the outfitting that produced it, so a `purse-pull` that
  # changes a manifest re-outfits this agent the next time you reach for it,
  # without waiting for a new container.
  local stamp="/dev/shm/purse-agent-outfitted.$command"
  local installed=1
  install_if_missing && installed=0

  if [ "$installed" = "0" ]; then
    outfit "$stamp"
  elif in_container && [ "$(cat "$stamp" 2> /dev/null)" != "$(outfit_fingerprint)" ]; then
    outfit "$stamp"
  fi
}

# ── herdr ────────────────────────────────────────────────────────────────────
# An agent typed at a container prompt cannot be made visible to herdr, and the
# limit is herdr's own, not something to work around. Detection happens on the
# host, from the pane's foreground process or the HERDR_AGENT hint set on it —
# both settled before a container prompt exists. `pane report-agent` supplies
# state for an agent herdr has already detected; it cannot create one, and
# herdr's own Claude integration reflects that, reporting only a session id.
#
# So say so, once, rather than leave the pane quietly unlabelled. `dcclaude`
# names the agent before exec and gets the real thing: identity, screen-read
# state, `agent wait` and `agent prompt`.
warn_herdr_cannot_see_us() {
  [ "${PURSE_AGENT_HERDR:-1}" = "0" ] && return 0
  [ "${HERDR_ENV:-}" = "1" ] || return 0
  [ -n "${HERDR_PANE_ID:-}" ] || return 0
  in_container || return 0
  # No point sending you to the other door for an agent herdr cannot name
  # either way — auggie, for one.
  [ -n "$(purse_agent_kind "$command")" ] || return 0

  local short
  short="$(purse_agent_short_name "$command")"
  printf 'purse-agent: herdr cannot detect an agent started from a container prompt.\n' >&2
  printf '             Start it from the host as `dc%s` to get a labelled pane.\n' "$short" >&2
}

# ── run ──────────────────────────────────────────────────────────────────────

provision
warn_herdr_cannot_see_us

export PURSE_AGENT_ACTIVE=1
exec "$command" "$@"
