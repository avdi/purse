# ~/.local/share/chezmoi/home/.chezmoiignore
# Files that chezmoi should not manage (not tracked in source state).

# Generated by purse-install-secrets — contains plaintext secrets, never committed
.config/shell/secrets.sh

# ~/.gitconfig is a thin, unmanaged stub (created once by
# run_once_setup-gitconfig-stub). The real, managed git config lives at
# ~/.config/git/config (XDG). Leaving the stub unmanaged means runtime
# mutations — notably VS Code's injected credential.helper — never dirty a
# chezmoi-tracked file.
.gitconfig

# Windows Terminal settings live at a Windows-only path. Ignore the whole
# AppData tree elsewhere so chezmoi doesn't create stub ~/AppData dirs on
# Linux/macOS.
{{ if ne .chezmoi.os "windows" }}
AppData
{{ end }}

# purse-install-extras is the Unix-only extras installer (dbr, micro, git from
# source, Homebrew) -- none of it applies on Windows, where winget covers the
# toolset. Worse, an extensionless file on PATH resolves as an Application with
# no shell association, so typing the name in PowerShell popped the "How do you
# want to open this file?" picker. The .ps1 counterpart is the Windows entry
# point. Note: an ignored path is dropped from the target state entirely, so
# .chezmoiremove cannot also delete a copy an earlier apply left behind --
# chezmoi rejects that pairing as an inconsistent state. Any such leftover is
# inert: PowerShell resolves the .ps1 ahead of an extensionless Application,
# so the picker stays gone regardless. Delete it by hand if it bothers you.
{{ if eq .chezmoi.os "windows" }}
.local/bin/purse-install-extras
{{ end }}
