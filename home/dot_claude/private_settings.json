{
  "permissions": {
    "allow": [
      "EnterWorktree",
      "ExitWorktree"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@context7-marketplace": true,
    "ralph-loop@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "worktrunk@worktrunk": true,
    "mattpocock-skills@mattpocock": true,
    "briefasaurus-overlay@410labs-agent-infra": true,
    "baseline@410labs-agent-infra": true,
    "mailstrom-overlay@410labs-agent-infra": false,
    "ruby-lsp@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "iterate-on-docs@iterate-on-docs": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "context7-marketplace": {
      "source": {
        "source": "github",
        "repo": "upstash/context7"
      }
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "iterate-on-docs": {
      "source": {
        "source": "github",
        "repo": "jessitron/iterate-on-docs"
      }
    }
  },
  "outputStyle": "Concise",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "permissionMode": "auto"
}
