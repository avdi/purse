{{- if ne .chezmoi.os "windows" -}}
#!/bin/bash
# chezmoi run_once: wire shell aliases and lenticel into rc files
# Idempotent — checks before appending.
#
# Gated to non-Windows — the rc files (.bashrc, .profile, .zshrc) only exist
# under WSL/macOS/Linux, and chezmoi can't fork/exec a .sh on native Windows.

# shellcheck disable=SC2016  # $HOME intentionally unexpanded — written as literal text into rc files
ALIASES_LINE='. "$HOME/.config/shell/aliases.sh"'
LENTICEL_LINE='. "$HOME/.config/lenticel/shell-setup.sh" 2>/dev/null || true'
MISE_BASH_LINE='eval "$(mise activate bash)"'
MISE_ZSH_LINE='eval "$(mise activate zsh)"'

_append_if_missing() {
  local file="$1"
  local marker="$2"
  local line="$3"
  if [ -f "$file" ] && ! grep -qF "$marker" "$file"; then
    printf '\n%s\n' "$line" >> "$file"
    echo "Added to $file: $line"
  fi
}

# Create the rc file for any shell that's actually installed, so the wiring
# below has somewhere to land. macOS is the case that forces this: zsh is the
# default login shell but ships no ~/.zshrc, and zsh never reads ~/.profile —
# so an append-only-if-present policy leaves a Mac with no purse wiring at all.
_ensure_rc_for_shell() {
  local shell_name="$1"
  local rc="$2"
  if command -v "$shell_name" >/dev/null 2>&1 && [ ! -f "$rc" ]; then
    printf '# Created by purse run_once_setup-shell\n' > "$rc"
    echo "Created $rc"
  fi
}

_ensure_rc_for_shell zsh ~/.zshrc
_ensure_rc_for_shell bash ~/.bashrc

# Shell aliases → .profile, .bashrc, .zshrc
for rc in ~/.profile ~/.bashrc ~/.zshrc; do
  _append_if_missing "$rc" '.config/shell/aliases.sh' "$ALIASES_LINE"
done

# Lenticel → .bashrc, .zshrc
for rc in ~/.bashrc ~/.zshrc; do
  _append_if_missing "$rc" '.config/lenticel/shell-setup.sh' "$LENTICEL_LINE"
done

# mise activate → .bashrc and .zshrc — puts the pinned tool versions
# (.ruby-version, etc.) on PATH per-directory.
_append_if_missing ~/.bashrc 'mise activate bash' "$MISE_BASH_LINE"
_append_if_missing ~/.zshrc 'mise activate zsh' "$MISE_ZSH_LINE"
{{- end }}
